{
  "name": "webpack-boilerplate",
  "version": "2.0.0",
  "description": "Sensible webpack 5 boilerplate using Babel and PostCSS with a hot dev server and an optimized production build.",
  "main": "index.js",
  "author": "Tania Rascia",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others \"yarn dev:hugo\" \"yarn dev:webpack\" \"yarn dev:proxy\"",
    "dev:proxy": "node server.js",
    "dev:webpack": "NODE_ENV=development webpack serve --mode development",
    "dev:hugo": "hugo server --port 1313 --watch",
    "build": "run-s build:*",
    "build:flickr": "node bin/flickr-feed.js",
    "build:webpack": "webpack --mode production",
    "build:hugo": "hugo --environment production",
    "flickr": "node bin/flickr-feed.js",
    "flickr:force": "node bin/flickr-feed.js --force",
    "flickr:sample": "node bin/flickr-feed.js --sample",
    "flickr:sample-images": "node bin/flickr-feed.js --sample-images",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:visual-update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.9",
    "@playwright/test": "^1.51.0",
    "@webpack-cli/serve": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "axios": "^1.18.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^9.1.2",
    "connect": "^3.7.0",
    "css-loader": "^7.1.2",
    "glob": "^10.3.10",
    "http-proxy-middleware": "^3.0.5",
    "https-localhost": "^4.7.1",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.0",
    "postcss-custom-media": "^10.0.2",
    "postcss-import": "^16.0.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.5",
    "postcss-reporter": "^7.1.0",
    "postcss-selector-parser": "^7.1.0",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "oauth-1.0a": "^2.2.6",
    "vanilla-lazyload": "^17.8.8"
  }
}
